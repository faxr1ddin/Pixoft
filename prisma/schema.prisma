generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vacancy {
  id              String   @id @default(cuid())
  code            Int      @unique @default(autoincrement())
  title           String
  company         String?
  companyLogo     String?
  category        String
  workType        String?
  locations       String[]
  workSchedule    String?
  address         String?
  description     String?
  benefits        String[]
  phones          String[]
  contactTelegram String?
  applyLink       String?
  sourceText      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  roles           Role[]

  @@index([isActive, createdAt(sort: Desc)])
}

model Role {
  id           String   @id @default(cuid())
  vacancyId    String
  vacancy      Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  title        String
  gender       String?
  ageRange     String?
  salaryMin    Int?
  salaryMax    Int?
  currency     String?
  requirements String[]

  @@index([vacancyId])
}
