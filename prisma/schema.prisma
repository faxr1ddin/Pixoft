generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vacancy {
  id              String   @id @default(cuid())
  code            Int      @unique @default(autoincrement())
  title           String
  positions       String[]
  company         String?
  companyLogo     String?
  workType        String?
  locations       String[]
  gender          String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  category        String
  ageRange        String?
  workSchedule    String?
  address         String?
  benefits        String[]
  requirements    String[]
  phones          String[]
  contactTelegram String?
  applyLink       String?
  sourceText      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([isActive, createdAt(sort: Desc)])
}
