generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vacancy {
  id              String   @id @default(cuid())
  title           String
  company         String
  companyLogo     String?
  workType        String
  location        String
  gender          String?
  salaryMin       Int
  salaryMax       Int?
  category        String
  ageRange        String?
  workSchedule    String?
  address         String?
  benefits        String[]
  requirements    String[]
  contactPhone    String?
  contactTelegram String?
  applyLink       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, category, createdAt(sort: Desc)])
  @@index([isActive, workType, createdAt(sort: Desc)])
  @@index([isActive, location, createdAt(sort: Desc)])
  @@index([isActive, gender, createdAt(sort: Desc)])
}
